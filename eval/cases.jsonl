# ---- Context guards and retired terms.
{"id": "guard-01", "category": "context-guard", "mode": "no-llm", "seed": [{"type": "add_term", "payload": {"preferred": "Kivi", "kind": "product", "note": "Sarvam's dictation product"}}, {"type": "set_trust", "payload": {"preferred": "Kivi", "trust": 4}}], "steps": [
  {"do": "observe", "asr": "i ate a kiwi for breakfast", "formatted": "I ate a kiwi for breakfast.", "presented": "I ate a Kivi for breakfast.", "final": "I ate a kiwi for breakfast.", "expect_reverted": ["Kivi"]},
  {"do": "run", "formatted": "She ate a kiwi after breakfast today.", "expect_output": "She ate a kiwi after breakfast today.", "expect_decisions": {"kiwi": "skipped:guarded"}, "expect_no_llm": true},
  {"do": "run", "formatted": "The kiwi dashboard is loading slowly.", "expect_output": "The kiwi dashboard is loading slowly.", "expect_decisions": {"kiwi": "skipped:context-unavailable"}}]}
# guard-02 exercises the judged half of the same guard: the food sentence is
# held back, so a product sentence must still reach the judge. Whether the
# judge then applies is model-dependent - the free endpoint declines this
# span in roughly one judged run in seven, under the load of a full eval -
# so either outcome counts, exactly as in hard-05. The mechanism itself is
# pinned deterministically by guard-01 above, which needs no key: there the
# product sentence reaches `context-unavailable`, not `guarded`, which is
# the whole claim ("restraint is as wide as the mistake, no wider").
{"id": "guard-02", "category": "context-guard", "seed": [{"type": "add_term", "payload": {"preferred": "Kivi", "kind": "product", "note": "Sarvam's dictation product"}}, {"type": "set_trust", "payload": {"preferred": "Kivi", "trust": 4}}], "requires_llm": true, "steps": [
  {"do": "observe", "asr": "i ate a kiwi for breakfast", "formatted": "I ate a kiwi for breakfast.", "presented": "I ate a Kivi for breakfast.", "final": "I ate a kiwi for breakfast.", "expect_reverted": ["Kivi"]},
  {"do": "run", "formatted": "Is the kiwi rollout finished yet?", "expect_output_any": ["Is the Kivi rollout finished yet?", "Is the kiwi rollout finished yet?"]}]}
{"id": "ret-01", "category": "retired", "seed": "persona", "steps": [
  {"do": "observe", "asr": "ask dhruv to come", "formatted": "Ask Dhruv to come.", "final": "Ask Dhruvv to come.", "expect_learned": ["Dhruvv"]},
