  {"do": "observe", "asr": "dhruv is waiting", "formatted": "Dhruv is waiting.", "final": "Dhruvv is waiting.", "expect_ignored": [{"new": "Dhruvv", "reason": "retired"}]},
  {"do": "assert_absent", "preferred": "Dhruvv"},
  {"do": "add", "preferred": "Dhruvv", "kind": "person"},
  {"do": "assert_term", "preferred": "Dhruvv", "status": "trusted"}]}
