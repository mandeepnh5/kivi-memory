# The system runs fully without any key (ambiguous words are safely skipped).
# To enable contextual judgment, set this:

GROQ_API_KEY=

# Optional. The values shown are the defaults; uncomment only to override.
# Do not append anything after the value - the whole line after "=" is used.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# Optional: seconds the judge may take before the span is left alone.
# Default 15, sized for the free tier; about 1 suits a dedicated endpoint.
# KIVI_JUDGE_TIMEOUT=15
